# Build-time settings (Vite). On Railway they are set per environment as service
# variables — literal values, Railway does not expand ${VAR}. Never commit a
# real .env: staging and production must each point at their OWN backend.
VITE_BACKEND_URL=https://cyber-place-server-staging.up.railway.app

# Map tiles (optional, same meaning as in the desktop panel)
# VITE_MAP_TILE_URL=

# Local development: use the panel checkout next door instead of fetching the
# pinned commit (see scripts/fetch-panel.mjs).
# PANEL_SRC=/var/www/html/cyber-place-panel-desktop

# Runtime, for the Caddy server (Caddyfile): the hosts this build may talk to.
# BACKEND_ORIGIN=https://cyber-place-server-staging.up.railway.app
# REVERB_ORIGIN=wss://cyber-place-reverb-staging.up.railway.app
