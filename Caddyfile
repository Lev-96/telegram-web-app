# Serves the built app (dist/) on Railway. Railpack's static Vite image uses
# this file instead of its default when it is at the repository root.
#
# BACKEND_ORIGIN and REVERB_ORIGIN are Railway service variables, set per
# environment, so a staging page may only talk to the staging backend and a
# production page only to production:
#   BACKEND_ORIGIN=https://cyber-place-server-production.up.railway.app
#   REVERB_ORIGIN=wss://cyber-place-reverb.up.railway.app
{
	admin off
	persist_config off
	auto_https off
	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:8080} {
	root * {$STATIC_ROOT:/app/dist}
	encode zstd gzip

	header {
		# default-src none, then only what the panel's screens need:
		# the backend (API, stored images), Reverb, Telegram's script,
		# map tiles and the address search the branch form uses.
		Content-Security-Policy "default-src 'none'; script-src 'self' https://telegram.org/js/telegram-web-app.js; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: {$BACKEND_ORIGIN} https://*.tile.openstreetmap.org https://server.arcgisonline.com https://*.basemaps.cartocdn.com; media-src 'self' blob: {$BACKEND_ORIGIN}; connect-src 'self' {$BACKEND_ORIGIN} {$REVERB_ORIGIN} https://nominatim.openstreetmap.org https://open.er-api.com; manifest-src 'self'; worker-src 'self' blob:; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'self' https://web.telegram.org https://webk.telegram.org https://webz.telegram.org"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		# The camera is for scanning a booking's QR code at the venue.
		Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		# Our files are ours: another site may not embed them as resources.
		Cross-Origin-Resource-Policy "same-origin"
		X-Permitted-Cross-Domain-Policies "none"
		-Server
	}

	# Hashed file names: cached for good. index.html: always revalidated, so a
	# deploy reaches everyone on their next load.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@entry path / /index.html
	header @entry Cache-Control "no-cache"
	# The service worker and the app manifest are fixed names: revalidated on
	# every load too, so a new worker or icon set reaches installed phones.
	@pwa path /sw.js /manifest.webmanifest
	header @pwa Cache-Control "no-cache"
	# Not every system's MIME table knows .webmanifest; file_server keeps a
	# Content-Type that is already set.
	@manifest path /manifest.webmanifest
	header @manifest Content-Type "application/manifest+json"

	# An allowlist, not a denylist, evaluated in exactly this order (route).
	#   - only GET and HEAD: a static page takes no writes, so POST, PUT,
	#     DELETE, TRACE and friends are 405 before anything else runs;
	#   - the app routes with the URL hash, so the ONLY paths a browser ever
	#     asks for are the page and its built files (Telegram's launch data
	#     and link codes travel in the hash and the query of "/"). Everything
	#     else — /.env, /.git, /wp-admin, *.php, /api/..., the source tree —
	#     is 404 without touching the file system, and a missing asset is a
	#     404 too, never the page in its place.
	#   - every top-level name in dist/ must be listed (tests/caddyfile.test.ts
	#     checks it against the panel's public/ and static/): /sounds/* was
	#     missing until 2026-11-09, so every chosen melody 404'd and the panel
	#     fell back to its default chime. /sw.js, /manifest.webmanifest and
	#     /icons/* are the installable app (static/).
	route {
		@unsafe not method GET HEAD
		respond @unsafe 405

		@app path / /index.html /logo.png /assets/* /fonts/* /bg/* /sounds/* /sw.js /manifest.webmanifest /icons/*
		file_server @app

		respond 404
	}
}
